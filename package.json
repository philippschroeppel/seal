{
  "name": "seal",
  "version": "0.1.0",
  "description": "Let an agent use identities without reading them: Seal performs HTTP and signing after Cedar allows it.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js"
    }
  },
  "bin": {
    "seal": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "node --import tsx src/demo.ts",
    "demo:agent": "node --import tsx src/demo-agent.ts",
    "demo:dist": "node dist/demo.js",
    "seal": "node --import tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "secrets",
    "sealed-box",
    "x25519",
    "broker",
    "cedar",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@cedar-policy/cedar-wasm": "^4.13.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
